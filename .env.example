# DigitallyDefined Backend — Supabase Edge Function Secrets
# Set these in Supabase Dashboard → Edge Functions → Secrets
# NEVER commit real values — this is a template only.

# Your Supabase project URL (auto-injected in edge functions, but needed for local dev)
SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Service role key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — at least one required for Hermes to work
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Preferred model (e.g. "openai/gpt-4o-mini" or "groq/llama-3.3-70b-versatile")
AI_MODEL=openai/gpt-4o-mini

# Custom API key that clients must send in x-api-key header
# Must match VITE_DASHBOARD_API_KEY in the dashboard / marketing site env files
HERMES_API_KEY=

# For local Node.js backend (src/index.js)
PORT=3001
INTEGRATION_NOTES=See ENV_VARIABLES_SUMMARY.md