{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://dashboard.digitallydefined.online"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-api-key, Authorization"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/intelligence(.*)",
      "destination": "/src/index"
    },
    {
      "source": "/api/quiz(.*)",
      "destination": "/src/index"
    },
    {
      "source": "/api/superpower(.*)",
      "destination": "/src/index"
    },
    {
      "source": "/api/roadmap(.*)",
      "destination": "/src/index"
    },
    {
      "source": "/api/scorecard(.*)",
      "destination": "/src/index"
    },
    {
      "source": "/health",
      "destination": "/src/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sellable",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/followup/day1",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/followup/day3",
      "schedule": "0 9 * * 2"
    },
    {
      "path": "/api/followup/day5",
      "schedule": "0 9 * * 4"
    },
    {
      "path": "/api/followup/day7",
      "schedule": "0 9 * * 6"
    },
    {
      "path": "/api/followup/day10",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/api/followup/day14",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/post-instagram",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/post-threads",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/post-facebook",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/post-community",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/post-engagement-prompt",
      "schedule": "0 8 * * 3"
    },
    {
      "path": "/api/cron/post-weekly-wins",
      "schedule": "0 8 * * 5"
    }
  ]
}
