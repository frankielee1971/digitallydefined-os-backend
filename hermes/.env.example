# ============================================
# HERMES - Authority Silo Architect Builder
# Environment Variables Template
# ============================================

# Copy this file to .env and fill in your actual values
# cp .env.example .env

# --------------------------------------------
# Gumroad Integration (Commerce)
# --------------------------------------------
# Get your API key from: https://app.gumroad.com/settings/advanced
GUMROAD_API_KEY=your_gumroad_api_key_here

# Get your product ID from your Gumroad product dashboard
GUMROAD_PRODUCT_ID=your_gumroad_product_id_here

# --------------------------------------------
# Supabase Integration (Database)
# --------------------------------------------
# Get these from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --------------------------------------------
# Notion Integration (Dashboard)
# --------------------------------------------
# Get your token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_token_here

# Get your database ID from the Notion database URL
# https://www.notion.so/username/DATABASE_ID?v=view_id
NOTION_DATABASE_ID=your_notion_database_id_here

# --------------------------------------------
# AgentOps Monitoring (Optional but Recommended)
# --------------------------------------------
# Get your API key from: https://app.agentops.ai/settings/projects
AGENTOPS_API_KEY=your_agentops_api_key_here

# --------------------------------------------
# Optional: Custom Configuration
# --------------------------------------------
# Override default log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
HERMES_LOG_LEVEL=INFO

# Override default config file path
HERMES_CONFIG_PATH=config.yaml

# --------------------------------------------
# Notes:
# --------------------------------------------
# 1. Never commit .env to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use environment-specific .env files (.env.development, .env.production)
# 4. For MCP deployment, set these as environment variables in your MCP server config