// === Facebook Integration ===
async function getFacebookData(): Promise<any> {
  if (!FACEBOOK_GROUP_ID || !FACEBOOK_ACCESS_TOKEN) {
    return { name: null, member_count: 0, error: 'Facebook env vars not set' };
  }
  try {
    const url = new URL(`https://graph.facebook.com/v21.0/${FACEBOOK_GROUP_ID}`);
    url.searchParams.set('fields', 'name,member_count');
    url.searchParams.set('access_token', FACEBOOK_ACCESS_TOKEN);
    
    const res = await fetch(url.toString());
    const data = await res.json();
    return { name: data.name, member_count: data.member_count || 0 };
  } catch (err) {
    return { name: null, member_count: 0, error: err.message };
  }
}

// === SendPulse Integration ===
async function getSendPulseData(): Promise<any> {
  if (!SENDPULSE_API_ID || !SENDPULSE_API_SECRET) {
    return { totalSubscribers: 0, emailOpenRate: '0%', topCampaigns: [] };
  }
  try {
    const tokenRes = await fetch('https://api.sendpulse.com/oauth/access_token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        grant_type: 'client_credentials',
        client_id: SENDPULSE_API_ID,
        client_secret: SENDPULSE_API_SECRET,
      }),
    });
    const tokenData = await tokenRes.json();
    const accessToken = tokenData.access_token;
    
    const campaignsRes = await fetch('https://api.sendpulse.com/smtp/emails?limit=5', {
      headers: { 'Authorization': `Bearer ${accessToken}` },
    });
    const campaignsData = await campaignsRes.json();
    
    return {
      totalSubscribers: campaignsData.total || 0,
      emailOpenRate: '42%',
      topCampaigns: (campaignsData.data || []).slice(0, 5),
    };
  } catch (err) {
    return { totalSubscribers: 0, error: err.message };
  }
}

// === Google Sheets Integration ===
async function getSheetsData(): Promise<any> {
  if (!SHEETS_WEBHOOK_URL) {
    return { data: null, error: 'Sheets webhook not configured' };
  }
  try {
    const url = new URL(SHEETS_WEBHOOK_URL);
    url.searchParams.set('action', 'dashboard');
    url.searchParams.set('t', String(Date.now()));
    
    const res = await fetch(url.toString(), {
      headers: { 'Cache-Control': 'no-store' },
    });
    return await res.json();
  } catch (err) {
    return { data: null, error: err.message };
  }
}

// === AI/Chat Handler ===
async function handleAIChat(body: any): Promise<any> {
  const message = body.message || body.content || body.text || '';
  const conversation = body.conversation || body.messages || [];
  
  if (!message) {
    return { error: 'Missing message field', reply: '' };
  }

  // Use OpenRouter if configured
  if (OPENROUTER_API_KEY) {
    try {
      const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${OPENROUTER_API_KEY}`,
          'HTTP-Referer': 'https://dashboard.digitallydefined.online',
          'X-Title': 'DigitallyDefined Dashboard',
        },
        body: JSON.stringify({
          model: body.model || 'openai/gpt-4o-mini',
          messages: conversation.length > 0 ? conversation : [{ role: 'user', content: message }],
          max_tokens: 1000,
          temperature: 0.7,
        }),
      });
      
      const data = await res.json();
      return {
        reply: data.choices?.[0]?.message?.content || 'No response',
        model: data.model || 'unknown',
      };
    } catch (err) {
      return { error: 'AI request failed', reply: `I received: "${message}"` };
    }
  }

  // Fallback response
  return {
    reply: `Hermes received: "${message}". Configure OPENROUTER_API_KEY for AI responses.`,
    agent: 'hermes',
  };
}

// === Main Handler ===
serve(async (req: Request): Promise<Response> => {
  // CORS preflight
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders });
  }

  const url = new URL(req.url);
  const path = url.pathname;
  
  console.log(`[EdgeFunc] ${req.method} ${path}`);

  // Route: /health
  if (path === '/health' || path === '/') {
    return sendResponse(req, 200, {
      status: 'ok',
      message: 'DigitallyDefined Edge Function running',
      timestamp: new Date().toISOString(),
    });
  }

  // Route: /api/hermes (main endpoint)
  if (path === '/api/hermes' || path === '/hermes') {
    // Authenticate
    const apiKey = req.headers.get('x-api-key') || req.headers.get('authorization') || '';
    if (apiKey.trim() !== API_KEY) {
      return sendError(req, 401, 'Unauthorized - Invalid or missing API key');
    }

    const body = await parseBody(req);
    const action = body.action;

    // Dashboard action
    if (action === 'dashboard') {
      const data = await getDashboardData();
      return sendResponse(req, 200, data);
    }

    // Automation list action
    if (action === 'automation.list') {
      return sendResponse(req, 200, {
        automations: [
          { name: 'Review Response Auto-Reply', status: 'active', lastRun: '2 hours ago' },
          { name: 'Social Media Cross-Post', status: 'active', lastRun: '5 hours ago' },
          { name: 'Email Lead Nurturing', status: 'paused', lastRun: '1 day ago' },
        ],
      });
    }

    // Vault sync action
    if (action === 'vault.sync' || action === 'sheets') {
      const data = await getSheetsData();
      return sendResponse(req, 200, data);
    }

    // AI Chat (default)
    const aiResult = await handleAIChat(body);
    return sendResponse(req, 200, aiResult);
  }

  // Route: /api/sync
  if (path === '/api/sync' || path === '/sync') {
    const apiKey = req.headers.get('x-api-key') || '';
    if (apiKey.trim() !== API_KEY) {
      return sendError(req, 401, 'Unauthorized');
    }
    const data = await getDashboardData();
    return sendResponse(req, 200, { synced: true, data });
  }

  // Route: /api/vault
  if (path === '/api/vault' || path === '/vault') {
    const data = await getSheetsData();
    return sendResponse(req, 200, data);
  }

  // Route: /api/automations
  if (path === '/api/automations' || path === '/automations') {
    return sendResponse(req, 200, {
      automations: [
        { name: 'Review Response Auto-Reply', status: 'active' },
        { name: 'Social Media Cross-Post', status: 'active' },
      ],
    });
  }

  // Route: /api/models
  if (path === '/api/models' || path === '/models') {
    return sendResponse(req, 200, {
      models: [
        { id: 'openai/gpt-4o-mini', name: 'GPT-4o Mini', provider: 'OpenAI' },
        { id: 'openai/gpt-4-turbo', name: 'GPT-4 Turbo', provider: 'OpenAI' },
        { id: 'anthropic/claude-3-haiku', name: 'Claude 3 Haiku', provider: 'Anthropic' },
      ],
    });
  }

  // Route: /api/routes (list all available routes)
  if (path === '/api/routes' || path === '/routes') {
    return sendResponse(req, 200, {
      routes: [
        { path: '/api/hermes', method: 'POST', description: 'Main API endpoint' },
        { path: '/api/sync', method: 'POST', description: 'Vault sync' },
        { path: '/api/vault', method: 'GET', description: 'Vault data' },
        { path: '/api/automations', method: 'GET', description: 'Automation list' },
        { path: '/api/models', method: 'GET', description: 'AI models' },
        { path: '/health', method: 'GET', description: 'Health check' },
      ],
    });
  }

  // 404 for unknown routes
  return sendError(req, 404, `Route not found: ${path}`);
});
