    "deployment": {
      "platform": "Vercel",
      "config": "vercel.json",
      "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1.js" },
        { "source": "/(.*)", "destination": "/index.html" }
      ],
      "csp": "script-src 'self' https://www.googletagmanager.com https://dijjlppdljpcgyoakdnq.supabase.co 'unsafe-inline' 'unsafe-eval'"
    },
    "folder_structure": {
      "src": "Source code (TypeScript/JavaScript)",
      "components": "React components",
      "api": "Frontend API routes",
      "auth": "Authentication logic",
      "lib": "Shared utilities",
      "public": "Static assets",
      "scripts": "Build/export scripts",
      "hermes": "Hermes AI integration",
      "dist": "Build output"
    }
  },
  "backend": {
    "project_name": "digitallydefined-os-backend",
    "location": "C:\\Users\\frank\\Documents\\Francescas_Brain\\DigitallyDefined-Workspace\\digitallydefined-os-backend",
    "runtime": "Node.js (ES Modules)",
    "frameworks": {
      "language": "TypeScript 5.9.3",
      "serverless": "Vercel Functions (@vercel/node 5.5.11)",
      "target": "ES2020"
    },
    "build_tools": {
      "typescript": "tsc --noEmit",
      "config": "tsconfig.json"
    },
    "key_dependencies": {
      "notion": "@notionhq/client 2.3.0",
      "firebase": "firebase-admin 13.5.0",
      "google": "googleapis 166.0.0",
      "utilities": ["chalk 5.6.2", "node-fetch 3.3.2"]
    },
    "deployment": {
      "platform": "Vercel",
      "config": "vercel.json",
      "cors": {
        "allowed_origins": [
          "https://dashboard.digitallydefined.online",
          "http://localhost:3000",
          "http://localhost:5173"
        ],
        "methods": "GET, POST, OPTIONS",
        "headers": "Content-Type, x-api-key, Authorization"
      },
      "cron_jobs": [
        { "schedule": "*/30 * * * *", "endpoint": "/api/cron/sellable?job=sellable-health&action=dry-run" },
        { "schedule": "0 8 * * 1", "endpoint": "/api/cron/sellable?job=revenue-automation&action=dry-run" },
        { "schedule": "0 9 * * 1", "endpoint": "/api/cron/sellable?job=seo-automation&action=dry-run" },
        { "schedule": "0 7 * * *", "endpoint": "/api/cron/sellable?job=daily-sellable-report&action=dry-run" },
        { "schedule": "0 8 1 * *", "endpoint": "/api/cron/sellable?job=monthly-revenue-review&action=dry-run" }
      ]
    },
    "api_routes": {
      "main_handler": "api/index.js",
      "endpoints": [
        "status",
        "auth.verify",
        "ai.recommendations",
        "brain.brief",
        "automation.sync",
        "automation.list",
        "automation.logs",
        "automation.run",
        "automation.events",
        "dashboard",
        "sheets",
        "notion-webhook",
        "test-env",
        "hermes",
        "routes",
        "brevo",
        "community-triggers",
        "social-publishers",
        "content.publish",
        "setup-notion",
        "quiz.history",
        "sellable-products.publish",
        "seo-automation.run",
        "revenue-automation.run",
        "customer-operations.run",
        "gumroad.webhook",
        "brevo.sync",
        "facebook.publish",
        "instagram.publish",
        "threads.publish",
        "linkedin.publish",
        "tiktok.publish",
        "youtube.publish",
        "pinterest.publish",
        "google_sheets.run",
        "cron.sellable.run"
      ]
    },
    "folder_structure": {
      "api": "Vercel serverless functions (30+ endpoints)",
      "hermes": "Python-based AI agent system (MCP server)",
      "lib": "Shared business logic libraries",
      "schemas": "JSON schema definitions",
